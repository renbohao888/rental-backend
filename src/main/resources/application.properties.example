# ============================================================
#  配置模板：复制本文件为 application.properties 并填入真实信息
#  （application.properties 已在 .gitignore 中，不会提交到 Git）
#
#  云端部署推荐使用环境变量覆盖，例如：
#    DB_URL / DB_USERNAME / DB_PASSWORD
#    REDIS_URL / REDIS_PASSWORD
#    ALIPAY_APP_ID / ALIPAY_PRIVATE_KEY / ALIPAY_PUBLIC_KEY
#    FILE_UPLOAD_PATH
#    AI_API_KEY（大模型 API Key）
# ============================================================
spring.application.name=anju-house-rental-platform

# MySQL 数据库
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/room_rent_db?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=GMT%2B8}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_password_here}

# 启动时自动建表（幂等：CREATE TABLE IF NOT EXISTS，不影响已有数据）
spring.sql.init.mode=always
spring.sql.init.schema-locations=classpath:init_cloud.sql
spring.sql.init.continue-on-error=true

# Redis
spring.data.redis.url=${REDIS_URL:redis://localhost:6379}
spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=${REDIS_PASSWORD:}

# MyBatis-Plus
mybatis-plus.mapper-locations=classpath:mapper/*.xml
mybatis-plus.type-aliases-package=com.anju.rental.entity
mybatis-plus.configuration.map-underscore-to-camel-case=true

# JWT 配置
jwt.secret=${JWT_SECRET:room-rent-system-secret-key-2025-123456}
jwt.expiration=${JWT_EXPIRATION:86400000}

# 支付宝（当前为沙箱；生产请替换为正式密钥）
alipay.appId=${ALIPAY_APP_ID:}
alipay.appPrivateKey=${ALIPAY_PRIVATE_KEY:}
alipay.alipayPublicKey=${ALIPAY_PUBLIC_KEY:}
alipay.serverUrl=${ALIPAY_SERVER_URL:https://openapi-sandbox.dl.alipaydev.com/gateway.do}
alipay.domain=${ALIPAY_DOMAIN:http://localhost:8080}

# 订单支付超时时间（分钟）
order.pay.timeout=3

# 文件上传
spring.servlet.multipart.max-file-size=100MB
spring.servlet.multipart.max-request-size=200MB
file.upload.path=${FILE_UPLOAD_PATH:./uploads}

# MyBatis-Plus SQL 日志（开发环境开启，生产环境请关闭）
mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl

# SpringDoc OpenAPI 配置
springdoc.api-docs.path=/api-docs
springdoc.swagger-ui.path=/swagger-ui.html
springdoc.swagger-ui.tags-sorter=alpha
springdoc.swagger-ui.operations-sorter=alpha

# Spring AI 大模型配置（接入通义千问 / DeepSeek / OpenAI 等兼容 API）
# 通义千问 DashScope API 示例：
spring.ai.openai.api-key=${AI_API_KEY:your-api-key}
spring.ai.openai.base-url=${AI_BASE_URL:https://dashscope.aliyuncs.com/compatible-mode/v1}
spring.ai.openai.chat.options.model=${AI_MODEL:qwen-plus}
spring.ai.openai.chat.options.temperature=0.7
